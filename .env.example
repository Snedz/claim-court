# PayPal sandbox configuration — copy to .env and fill in LOCALLY.
# Credentials are founder-gated: they come from the founder's
# developer.paypal.com login (readiness pack §2). NEVER commit a filled
# .env; .gitignore already excludes it. These blanks are placeholders,
# not real values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
# Toolkit client (paypal_toolkit_client.py) only: sandbox vs live is the
# toolkit's Context flag. "true" = sandbox. Flip to "false" only for a
# deliberate live run — never for the hackathon.
PAYPAL_SANDBOX=true
